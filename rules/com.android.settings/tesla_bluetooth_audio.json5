{
  key: 1,
  name: 'Tesla蓝牙音频自动开启',
  desc: '进入Tesla蓝牙设备子设置页面时，自动开启Calls和Audio开关',
  activityIds: [
    'com.android.settings.SubSettings',
  ],
  rules: [
    {
      key: 0,
      name: '开启Calls开关',
      // 仅在Tesla设备页面，且开关处于关闭状态时点击
      matches: [
        '[text*="Tesla"]',
        '[text="Calls"] <<n LinearLayout > LinearLayout > Switch[id="android:id/switch_widget"][checked=false]',
      ],
      actionDelay: 500,
      fastQuery: true,
      snapshotUrls: [],
    },
    {
      key: 1,
      name: '开启Audio开关',
      matches: [
        '[text*="Tesla"]',
        '[text="Audio"] <<n LinearLayout > LinearLayout > Switch[id="android:id/switch_widget"][checked=false]',
      ],
      actionDelay: 500,
      fastQuery: true,
      snapshotUrls: [],
    },
  ],
}
