{
  key: 1,
  name: '自动跳出微信打开链接',
  desc: '自动打开微信网页中的链接：小红书域名用小红书 App，其他用浏览器',
  activityIds: [
    'com.tencent.mm.plugin.webview.ui.tools.MMWebViewUI',
  ],
  rules: [
    {
      key: 0,
      name: '点击更多信息',
      actionMaximum: 1,
      matchDelay: 500,
      matches: [
        '[desc="更多信息"][clickable=true]',
      ],
      anyMatches: [
        '[id="android:id/text1"][text*="."]',
      ],
      actionDelay: 100,
      fastQuery: true,
      snapshotUrls: [],
    },
    {
      key: 4,
      name: '小红书网页：把入口滑出来',
      desc: '「在小红书中打开」在第二排最右边、屏幕外，GKD 看不到；在「在浏览器中打开」上往左滑一段',
      preKeys: [
        0,
      ],
      matches: [
        '[text*="xiaohongshu.com" || text*="xhslink.com"]',
        '[text="在浏览器中打开" || text="Open in browser"]',
      ],
      excludeMatches: [
        '[clickable=true] > [(text*="小红书" && text*="打开") || text*="rednote" || text*="RedNote" || text*="Xiaohongshu"]',
      ],
      swipeArg: {
        start: { left: 'width/2', top: 'height/2' },
        end: { left: 'width/2 - screenWidth*0.6', top: 'height/2' },
        duration: 300,
      },
      actionDelay: 200,
      actionCd: 800,
      actionMaximum: 2,
      fastQuery: true,
      snapshotUrls: [],
    },
    {
      key: 3,
      name: '小红书网页用小红书打开',
      desc: '菜单里的网页来源是小红书域名时，点「在小红书中打开 / Open in rednote」',
      preKeys: [
        0,
        4,
      ],
      // matches 全部命中后点的是最后一个选择器的节点，所以按钮放最后
      matches: [
        '[text*="xiaohongshu.com" || text*="xhslink.com"]',
        '[clickable=true] > [(text*="小红书" && text*="打开") || text*="rednote" || text*="RedNote" || text*="Xiaohongshu"]',
      ],
      actionDelay: 200,
      fastQuery: true,
      actionMaximum: 1,
      snapshotUrls: [],
    },
    {
      key: 1,
      name: '点击在浏览器打开',
      desc: '非小红书域名的网页一律用浏览器打开',
      preKeys: [
        0,
      ],
      excludeMatches: [
        '[text*="xiaohongshu.com" || text*="xhslink.com"]',
      ],
      anyMatches: [
        '[clickable=true] > [text="在浏览器中打开"]',
        '[clickable=true] > [text="Open in browser"]',
        '[clickable=true] > [text*="Open in"][text!*="rednote"][text!*="RedNote"][text!*="Xiaohongshu"]',
      ],
      actionDelay: 200,
      fastQuery: true,
      actionMaximum: 1,
      snapshotUrls: [],
    },
    {
      key: 5,
      name: '跳出后回到微信：关掉这个网页',
      desc: '回到微信时 GKD 会重置计数、整套流程又跑一遍；如果最后触发的是本组的打开/允许，说明刚跳出去过，直接按返回关掉网页',
      preKeys: [
        1,
        2,
        3,
      ],
      matches: [
        '[desc="更多信息"][clickable=true]',
      ],
      action: 'back',
      order: -2,
      // 比 key 0 的 matchDelay 短，回到网页时先按返回，key 0 来不及点「更多信息」
      actionDelay: 300,
      actionMaximum: 1,
      fastQuery: true,
      snapshotUrls: [],
    },
    {
      key: 2,
      name: '点击允许',
      // 确认跳转的弹窗可能是单独的 WebViewStubProxyUI；在这里点掉（order 比「Auto Click Allow」组靠前），
      // 让「最后触发的规则」留在本组，回到微信时 key 5 才认得出来
      activityIds: [
        'com.tencent.mm.plugin.webview.ui.tools.MMWebViewUI',
        'com.tencent.mm.plugin.webview.stub.WebViewStubProxyUI',
      ],
      order: -1,
      preKeys: [
        1,
        3,
      ],
      anyMatches: [
        '[text="允许"][clickable=true]',
        '[text="Allow"][clickable=true]',
      ],
      actionDelay: 100,
      fastQuery: true,
      snapshotUrls: [],
    },
  ],
}